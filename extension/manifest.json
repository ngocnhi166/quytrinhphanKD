{
  "manifest_version": 3,
  "name": "SCOPE T12 — Kết nối ChatGPT",
  "version": "1.1.0",
  "minimum_chrome_version": "116",
  "description": "Kết nối AI Agent với tài khoản SCOPE T12 và ChatGPT của riêng bạn.",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://scope-t12.vercel.app/*",
    "https://scope-t12-backend.onrender.com/*",
    "http://127.0.0.1:8000/*",
    "http://127.0.0.1:3000/*",
    "http://localhost:3000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SCOPE T12 — Kết nối ChatGPT"
  }
}
