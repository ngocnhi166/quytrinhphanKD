{
  "manifest_version": 3,
  "name": "T12 Studio — ChatGPT Local Bridge",
  "version": "1.0.13",
  "minimum_chrome_version": "116",
  "description": "Nhận CSV/XLSX và yêu cầu phân tích từ T12 Studio, xử lý trong tab ChatGPT của bạn.",
  "permissions": ["tabs", "scripting", "storage", "alarms"],
  "host_permissions": ["https://chatgpt.com/*", "http://127.0.0.1:8000/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_popup": "popup.html", "default_title": "Kết nối T12 Studio"}
}
