# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local analysis data
.venv/
__pycache__/
*.pyc
# The SQLite database is versioned so every clone shares accounts, tasks and history.
# Plain-text initial passwords, the per-machine extension key and SQLite temp files stay local.
backend/data/*
!backend/data/studio.sqlite3
**/.next/
**/node_modules/
